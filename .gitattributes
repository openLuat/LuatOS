# ── Root .gitattributes ──
# Applies to the ENTIRE repository (overrides are additive, not scoped).
# The bsp/.gitattributes is still effective for its subtree; this file
# sets the default for everything else — especially mcp/ Python sources.

# ── Auto-detect: treat as text, normalize to LF ──
* text=auto eol=lf

# ── Python (MCP services live here) ──
*.py       text eol=lf
*.pyi      text eol=lf
*.pyx      text eol=lf
*.toml     text eol=lf
*.cfg      text eol=lf
requirements*.txt text eol=lf

# ── C / Lua / docs (match bsp/.gitattributes for consistency) ──
*.c        text eol=lf
*.h        text eol=lf
*.cpp      text eol=lf
*.cc       text eol=lf
*.lua      text eol=lf
*.proto    text eol=lf

# ── Scripts ──
*.sh       text eol=lf
*.bash     text eol=lf
Makefile   text eol=lf
*.mk       text eol=lf
*.cmake    text eol=lf

# ── Windows scripts: MUST be CRLF or cmd/pwsh may choke ──
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf
*.psm1     text eol=crlf
*.psd1     text eol=crlf

# ── Data / config ──
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.xml      text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.csv      text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.js       text eol=lf
*.ts       text eol=lf

# ── Binary: never mangle line-endings ──
*.bin      binary
*.so       binary
*.dll      binary
*.a        binary
*.lib      binary
*.o        binary
*.obj      binary
*.elf      binary
*.hex      binary
*.soc      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.bmp      binary
*.zip      binary
*.gz       binary
*.tar      binary
*.7z       binary
*.exe      binary
*.dmg      binary
*.iso      binary
*.pdf      binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.mp3      binary
*.mp4      binary
*.luac     binary
